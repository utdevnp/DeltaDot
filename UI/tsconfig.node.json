{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron",
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron/**/*", "core/**/*"],
  "exclude": ["node_modules", "dist", "src"]
}
