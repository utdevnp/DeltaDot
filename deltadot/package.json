{
  "name": "deltadot",
  "version": "1.0.0",
  "description": "Terminal-native CLI to check if local Git repositories are structurally synchronized with their upstream remotes.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "deltadot": "./bin/deltadot.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.tsx"
  },
  "keywords": [
    "git",
    "cli",
    "sync",
    "branches"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.0.5",
    "ink-text-input": "^6.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/ink-text-input": "^2.0.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
